{
  "title": "中古カメラ市場クローラー",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchKeyword": {
      "title": "検索キーワード",
      "type": "string",
      "description": "カメラ名・レンズ名などを指定（空欄で全カテゴリ対象）",
      "prefill": "α7",
      "editor": "textfield"
    },
    "maxItems": {
      "title": "最大取得件数",
      "type": "integer",
      "description": "取得する最大商品数",
      "default": 100,
      "minimum": 1
    },
    "maxPages": {
      "title": "最大ページ数",
      "type": "integer",
      "description": "各ソースで取得する最大ページ数",
      "default": 2,
      "minimum": 1
    },
    "sources": {
      "title": "取得ソース",
      "type": "string",
      "description": "カンマ区切りで指定（kitamura,fujiya）",
      "default": "kitamura,fujiya",
      "editor": "textfield"
    },
    "proxyConfiguration": {
      "title": "Proxy設定",
      "type": "object",
      "editor": "proxy",
      "description": "Apifyプロキシ設定（自動）",
      "default": {
        "useApifyProxy": true
      }
    }
  },
  "required": []
}
